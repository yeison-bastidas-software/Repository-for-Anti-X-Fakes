# Copy this file to .env and fill in your keys. Never commit .env to git.

# Google Fact Check Tools API (ClaimSearch) key — free tier:
# https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
CLAIMSEARCH_API_KEY=your_claimsearch_api_key_here

# Gemini API key (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
